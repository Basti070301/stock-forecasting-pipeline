# Default: no external APIs, no PostgreSQL required.
SI_MODE=demo
SI_FINBERT_ENABLED=false
SI_FINBERT_DEVICE=-1
SI_ALPHA_VANTAGE_KEY=
# Optional local mutation token. Set for Docker access through its bridge.
SI_MUTATION_TOKEN=
SI_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Used only in live mode / original pipeline. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=stock_forecasting
DB_USER=postgres
DB_PASSWORD=replace_me

# M3: real news are independent of the historical/demo price mode.
SI_NEWS_ENABLED=false
SI_NEWS_PROVIDER=finnhub
SI_FINNHUB_KEY=
# Enable only after verifying private use/storage/analysis rights for your account.
SI_NEWS_RIGHTS_ACCEPTED=false
# Metadata/title only by default; summaries require separate permission.
SI_NEWS_STORE_SUMMARIES=false
SI_NEWS_RSS_FEEDS=[]
SI_NEWS_AUTO_REFRESH=false
SI_NEWS_INTERVAL_SECONDS=900
SI_NEWS_MAX_CYCLES=24
SI_NEWS_DAILY_BUDGET=100
SI_NEWS_BATCH_SIZE=8
SI_NEWS_STALE_HOURS=24

# M4.1: only operator-owned, hash-checked local models. No weights in Git.
# Optional root; default: SI_RUNTIME_DIR/research-models
# SI_RESEARCH_ARTIFACT_DIR=C:/path/to/trusted/research-models
SI_RESEARCH_TRUST_LOCAL_ARTIFACTS=false

# M4.2a: manual daily bars, independent of SI_MODE (database namespace).
# Both flags stay false until provider access/storage/use is actually permitted.
SI_MARKET_ENABLED=false
SI_MARKET_RIGHTS_ACCEPTED=false
# Non-secret local reference to the permission/terms review; not an API key.
SI_MARKET_RIGHTS_REFERENCE=
SI_MARKET_TIMEOUT_SECONDS=15
SI_MARKET_MAX_ATTEMPTS=3
SI_MARKET_DAILY_BUDGET=20
SI_MARKET_MIN_INTERVAL_SECONDS=3
# Unknown by default. Set only a verified provider delay, never assume real time.
# SI_MARKET_DELAY_SECONDS=900
