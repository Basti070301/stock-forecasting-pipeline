# Default: no external APIs, no PostgreSQL required.
SI_MODE=demo
SI_FINBERT_ENABLED=false
SI_FINBERT_DEVICE=-1
SI_ALPHA_VANTAGE_KEY=
# Optional local mutation token. Set for Docker access through its bridge.
SI_MUTATION_TOKEN=
SI_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Used only in live mode / original pipeline. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=stock_forecasting
DB_USER=postgres
DB_PASSWORD=replace_me
