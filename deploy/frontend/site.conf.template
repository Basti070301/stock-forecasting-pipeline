server {
    listen 127.0.0.1:8081;
    location = /healthz { access_log off; return 200 'ok'; }
}
server {
    listen 8443 ssl default_server;
    server_name ${SI_PUBLIC_HOST};
    if ($host != '${SI_PUBLIC_HOST}') { return 444; }
    ssl_certificate /var/lib/si-tls/server.crt;
    ssl_certificate_key /var/lib/si-tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:1m;
    auth_basic "Stock Intelligence AI";
    auth_basic_user_file /tmp/si-nginx/htpasswd;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control no-store always;
    client_max_body_size 16k;
    root /usr/share/nginx/html;
    location ~ ^/(docs|redoc|openapi.json)(/|$) { return 404; }
    location /api/ {
        limit_except GET { deny all; }
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $backend http://si-backend:8000;
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization "";
        proxy_set_header X-SI-Proxy-Token "${SI_PROXY_TOKEN}";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Forwarded "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
    location / {
        limit_except GET { deny all; }
        try_files $uri $uri/ /index.html;
    }
}
